{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "unicorn", "oxc", "import", "jsx-a11y", "promise"],
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "error" },
  "categories": { "correctness": "error", "suspicious": "error", "perf": "warn" },
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",

    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/consistent-return": "off",
    "unicorn/no-array-reverse": "off",
    "oxc/no-map-spread": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-non-null-assertion": "error",

    "eslint/no-nested-ternary": "error",
    "unicorn/no-nested-ternary": "off",
    "eslint/max-lines": ["error", { "max": 250, "skipBlankLines": true, "skipComments": true }],
    "eslint/max-params": ["error", { "max": 4 }],
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-console": "error",
    "eslint/no-await-in-loop": "off",
    "jsx-a11y/no-autofocus": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],

    "import/no-cycle": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "promise/no-multiple-resolved": "error",

    "react/forbid-elements": [
      "error",
      {
        "forbid": [
          { "element": "button", "message": "use Button, Chip, Checkbox or Segmented from @/ui" },
          { "element": "input", "message": "use Input from @/ui" },
          { "element": "select", "message": "use Select from @/ui" },
          { "element": "textarea", "message": "use Textarea from @/ui" },
          { "element": "dialog", "message": "use Sheet or Dialog from @/ui" }
        ]
      }
    ],
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "dexie", "message": "storage lives in @/data/db" },
          { "name": "dexie-react-hooks", "message": "storage lives in @/data/db" }
        ],
        "patterns": [{ "group": ["../*"], "message": "import across folders through @/" }]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/ui/**"],
      "rules": {
        "react/forbid-elements": "off",
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/*", "!@/ui/*"],
                "message": "ui is the bottom layer: it imports nothing of the app"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/data/*", "@/state/*", "@/features/*", "@/app/*", "@/ui/*", "react", "react-dom"],
                "message": "domain is plain TypeScript"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/data/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@/state/*", "@/features/*", "@/app/*"], "message": "data does not reach up" }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/state/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["@/features/*", "@/app/*"], "message": "state does not reach up" }] }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "dexie", "message": "storage lives in @/data/db" },
              { "name": "dexie-react-hooks", "message": "storage lives in @/data/db" }
            ],
            "patterns": [{ "group": ["@/app/*"], "message": "features do not import the shell" }]
          }
        ]
      }
    },
    {
      "files": ["vite.config.ts"],
      "rules": { "eslint/no-restricted-imports": "off", "eslint/no-console": "off" }
    }
  ]
}
