 "InpaintCropImproved": {
  "input": {
   "optional": {
    "mask": [
     "MASK"
    ],
    "optional_context_mask": [
     "MASK"
    ]
   },
   "required": {
    "context_from_mask_extend_factor": [
     "FLOAT",
     {
      "default": 1.2,
      "max": 100.0,
      "min": 1.0,
      "step": 0.01,
      "tooltip": "Grow the context area from the mask by a certain factor in every direction. For example, 1.5 grabs extra 50% up, down, left, and right as context."
     }
    ],
    "device_mode": [
     [
      "cpu (compatible)",
      "gpu (much faster)"
     ],
     {
      "default": "cpu (compatible)"
     }
    ],
    "downscale_algorithm": [
     [
      "nearest",
      "bilinear",
      "bicubic",
      "lanczos",
      "box",
      "hamming"
     ],
     {
      "default": "bilinear"
     }
    ],
    "extend_down_factor": [
     "FLOAT",
     {
      "default": 1.0,
      "max": 100.0,
      "min": 0.01,
      "step": 0.01
     }
    ],
    "extend_for_outpainting": [
     "BOOLEAN",
     {
      "default": false,
      "tooltip": "Extend the image for outpainting."
     }
    ],
    "extend_left_factor": [
     "FLOAT",
     {
      "default": 1.0,
      "max": 100.0,
      "min": 0.01,
      "step": 0.01
     }
    ],
    "extend_right_factor": [
     "FLOAT",
     {
      "default": 1.0,
      "max": 100.0,
      "min": 0.01,
      "step": 0.01
     }
    ],
    "extend_up_factor": [
     "FLOAT",
     {
      "default": 1.0,
      "max": 100.0,
      "min": 0.01,
      "step": 0.01
     }
    ],
    "image": [
     "IMAGE"
    ],
    "mask_blend_pixels": [
     "INT",
     {
      "default": 32,
      "max": 256,
      "min": 0,
      "step": 1,
      "tooltip": "How many pixels to blend into the original image."
     }
    ],
    "mask_expand_pixels": [
     "INT",
     {
      "default": 0,
      "max": 16384,
      "min": 0,
      "step": 1,
      "tooltip": "Expand the mask by a certain amount of pixels before processing."
     }
    ],
    "mask_fill_holes": [
     "BOOLEAN",
     {
      "default": true,
      "tooltip": "Mark as masked any areas fully enclosed by mask."
     }
    ],
    "mask_hipass_filter": [
     "FLOAT",
     {
      "default": 0.1,
      "max": 1,
      "min": 0,
      "step": 0.01,
      "tooltip": "Ignore mask values lower than this value."
     }
    ],
    "mask_invert": [
     "BOOLEAN",
     {
      "default": false,
      "tooltip": "Invert mask so that anything masked will be kept."
     }
    ],
    "output_padding": [
     [
      "0",
      "8",
      "16",
      "32",
      "64",
      "128",
      "256",
      "512"
     ],
     {
      "default": "32"
     }
    ],
    "output_resize_to_target_size": [
     "BOOLEAN",
     {
      "default": true,
      "tooltip": "Force a specific resolution for sampling."
     }
    ],
    "output_target_height": [
     "INT",
     {
      "default": 512,
      "max": 16384,
      "min": 64,
      "step": 1
     }
    ],
    "output_target_width": [
     "INT",
     {
      "default": 512,
      "max": 16384,
      "min": 64,
      "step": 1
     }
    ],
    "preresize": [
     "BOOLEAN",
     {
      "default": false,
      "tooltip": "Resize the original image before processing."
     }
    ],
    "preresize_max_height": [
     "INT",
     {
      "default": 16384,
      "max": 16384,
      "min": 0,
      "step": 1
     }
    ],
    "preresize_max_width": [
     "INT",
     {
      "default": 16384,
      "max": 16384,
      "min": 0,
      "step": 1
     }
    ],
    "preresize_min_height": [
     "INT",
     {
      "default": 1024,
      "max": 16384,
      "min": 0,
      "step": 1
     }
    ],
    "preresize_min_width": [
     "INT",
     {
      "default": 1024,
      "max": 16384,
      "min": 0,
      "step": 1
     }
    ],
    "preresize_mode": [
     [
      "ensure minimum resolution",
      "ensure maximum resolution",
      "ensure minimum and maximum resolution"
     ],
     {
      "default": "ensure minimum resolution"
     }
    ],
    "upscale_algorithm": [
     [
      "nearest",
      "bilinear",
      "bicubic",
      "lanczos",
      "box",
      "hamming"
     ],
     {
      "default": "bicubic"
     }
    ]
   }
  },
